{
  "name": "go-tokenless",
  "displayName": "go-tokenless",
  "version": "1.0.0",
  "description": "Move npm publishing in GitHub Actions from NPM_TOKEN to trusted publishing (OIDC): an Agent Skill plus an MCP server that plans and applies the workflow changes.",
  "author": {
    "name": "Continuous-Actions",
    "url": "https://github.com/Continuous-Actions"
  },
  "homepage": "https://github.com/Continuous-Actions/go-tokenless",
  "repository": "https://github.com/Continuous-Actions/go-tokenless",
  "license": "MIT",
  "keywords": [
    "npm",
    "trusted-publishing",
    "oidc",
    "github-actions",
    "release"
  ],
  "mcpServers": {
    "go-tokenless": {
      "command": "npx",
      "args": [
        "-y",
        "go-tokenless@1.0.0",
        "mcp"
      ]
    }
  }
}
